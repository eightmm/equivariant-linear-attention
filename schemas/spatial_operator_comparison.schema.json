{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eightmm/equivariant-linear-attention/schemas/spatial_operator_comparison.schema.json",
  "title": "Spatial operator comparison result",
  "type": "object",
  "required": [
    "schema_version",
    "experiment",
    "arms",
    "tasks",
    "seeds",
    "protocol",
    "audits",
    "runs",
    "summaries"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 2
    },
    "experiment": {
      "const": "spatial_operator_comparison"
    },
    "arms": {
      "const": ["explicit", "implicit", "hybrid"]
    },
    "tasks": {
      "type": "array",
      "items": {
        "enum": ["local_directional", "smooth_gaussian", "mixed"]
      },
      "uniqueItems": true
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "uniqueItems": true
    },
    "device": {
      "type": "string"
    },
    "compute_dtype": {
      "enum": ["float32", "bfloat16", "float64"]
    },
    "neighbor_discovery_included": {
      "const": false
    },
    "protocol": {
      "type": "object",
      "required": [
        "same_parameter_schema",
        "same_initial_state_per_task_seed",
        "same_train_validation_data_per_task_seed",
        "validation_or_test_labels_used_for_training",
        "no_edge_graph_prepared_outside_timed_forward",
        "arguments"
      ],
      "properties": {
        "same_parameter_schema": {"const": true},
        "same_initial_state_per_task_seed": {"const": true},
        "same_train_validation_data_per_task_seed": {"const": true},
        "validation_or_test_labels_used_for_training": {"const": false},
        "no_edge_graph_prepared_outside_timed_forward": {"const": true},
        "arguments": {"type": "object"}
      },
      "additionalProperties": true
    },
    "audits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task",
          "seed",
          "train_data_sha256",
          "validation_data_sha256",
          "initial_state_sha256",
          "initial_equivalence",
          "parameter_count"
        ],
        "properties": {
          "task": {"type": "string"},
          "seed": {"type": "integer"},
          "train_data_sha256": {"type": "string"},
          "validation_data_sha256": {"type": "string"},
          "initial_state_sha256": {"type": "string"},
          "parameter_count": {"type": "integer", "minimum": 1},
          "initial_equivalence": {
            "type": "object",
            "required": [
              "explicit_vs_hybrid_max_abs",
              "explicit_vs_implicit_max_abs",
              "implicit_edge_independence_max_abs"
            ],
            "properties": {
              "explicit_vs_hybrid_max_abs": {"type": "number"},
              "explicit_vs_implicit_max_abs": {"type": "number"},
              "implicit_edge_independence_max_abs": {"type": "number"}
            }
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task",
          "seed",
          "arm",
          "initial_state_sha256",
          "audit",
          "best_step",
          "best_validation",
          "final_validation",
          "median_train_step_ms",
          "inference_ms",
          "training_peak_allocated_bytes",
          "inference_peak_allocated_bytes",
          "clip_fraction",
          "curve"
        ],
        "properties": {
          "task": {"type": "string"},
          "seed": {"type": "integer"},
          "arm": {"enum": ["explicit", "implicit", "hybrid"]},
          "initial_state_sha256": {"type": "string"},
          "best_step": {"type": "integer", "minimum": 1},
          "median_train_step_ms": {"type": "number", "minimum": 0},
          "inference_ms": {"type": "number", "minimum": 0},
          "training_peak_allocated_bytes": {"type": "integer", "minimum": 0},
          "inference_peak_allocated_bytes": {"type": "integer", "minimum": 0},
          "clip_fraction": {"type": "number", "minimum": 0, "maximum": 1},
          "best_validation": {"$ref": "#/$defs/metrics"},
          "final_validation": {"$ref": "#/$defs/metrics"},
          "audit": {
            "type": "object",
            "required": ["arm", "parameter_count", "state_dict_sha256"]
          },
          "curve": {
            "type": "array"
          }
        }
      }
    },
    "summaries": {
      "type": "array"
    }
  },
  "$defs": {
    "metrics": {
      "type": "object",
      "required": ["normalized_mse", "mae", "rmse", "pearson"],
      "properties": {
        "normalized_mse": {"type": "number"},
        "mae": {"type": "number"},
        "rmse": {"type": "number"},
        "pearson": {"type": "number"}
      }
    }
  },
  "additionalProperties": true
}
