+        row = _model_row(
+            model=model,
+            model_name="model",
+            node_feats=node_feats,
+            pos=pos,
+            batch=batch,
+            edge_index=edge_index,
+            comparison="same_seeded_exact_edge_set",
+            warmup=warmup,
+            repeats=repeats,
