        "7",
        "--max-wall-seconds",
        "120",
        "--metrics-out",
        "artifacts/edge-multiplier-scaling-20260723/gpu-grid.json"
      ]
    },
    {
      "id": "cuda-crossover-seed-template",
      "argv_template": [
        ".venv/bin/python",
        "scripts/benchmark_sparse_scaling.py",
        "--edge-multiplier-grid",
        "--sizes",
        "8192",
        "--edge-multipliers",
        "64",
        "128",
        "32",
        "--device",
        "cuda",
        "--seed",
        "{20260723|20260724|20260725}",
        "--model-seed",
        "20260723",
        "--warmup",
        "10",
        "--repeats",
        "31",
        "--max-wall-seconds",
        "60",
        "--metrics-out",
        "{corresponding run-local gpu-crossover JSON}"
      ],
      "note": "The multiplier order intentionally reverses model execution order at the boundary relative to the full grid where applicable."
    },
    {
      "id": "profile",
      "argv": [
        ".venv/bin/python",
        "artifacts/edge-multiplier-scaling-20260723/profile_high_density.py",
