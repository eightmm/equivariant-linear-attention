        "8192",
        "--edge-multiplier",
        "128",
        "--seed",
        "20260723",
        "--model-seed",
        "20260723",
        "--warmup",
        "5",
        "--forwards",
        "10"
      ],
      "note": "Profiler timings are diagnostic; synchronized benchmark medians remain authoritative."
    },
    {
      "id": "fast-gate",
      "argv": ["scripts/check.sh", "fast"]
    },
    {
      "id": "gpu-gate",
      "argv": ["scripts/check.sh", "gpu"]
    }
