  "run_id": "architecture-v2-positive-tensor-20260723",
  "question": "Can bounded positive scalar magnitude and a shifted persistent-2e Frobenius feature improve real-data selectivity while preserving exact fixed-width O(N), O(3), positivity, permutation, batch-isolation, and disabled-path compatibility contracts?",
  "plan": [
    {
      "id": "P1",
      "text": "Freeze architecture, claims, data boundaries, thresholds, and compute budget.",
      "done_criteria": "A run-local scope records all arms, falsifiers, non-goals, and test-access rules.",
      "status": "completed"
    },
    {
      "id": "P2",
      "text": "Write narrow RED algebra, compatibility, symmetry, and integration contracts.",
      "done_criteria": "Tests fail for the missing mechanism and cover the public mathematical boundary.",
      "status": "completed"
    },
    {
      "id": "P3",
      "text": "Implement bounded scalar content and shifted persistent-2e attention as opt-in paths.",
      "done_criteria": "The default remains unchanged and the candidate is wired through public construction and the matched runner.",
      "status": "completed"
    },
    {
      "id": "P4",
      "text": "Run focused, full fast, and strict-CUDA finite-gradient gates.",
      "done_criteria": "All registered software checks pass without nonfinite state.",
      "status": "completed"
    },
    {
      "id": "P5",
      "text": "Run the frozen staged QM9 screen and only an admitted confirmation.",
      "done_criteria": "The screen completes with hashes and no test labels; a failed screen stops confirmation.",
      "status": "completed"
    },
    {
      "id": "P6",
      "text": "Run the frozen ATOM3D-LBA train-only capacity comparison.",
      "done_criteria": "Incumbent, combined candidate, and private EGNN complete or record a bounded terminal failure without validation/test access.",
      "status": "completed"
    },
    {
      "id": "P7",
      "text": "Package claims, counterevidence, source lineage, commands, environment, and public documentation.",
      "done_criteria": "A hash-valid bundle exposes both original and initialization-repaired null results without pooling them.",
      "status": "completed"
