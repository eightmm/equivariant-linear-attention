+    inverse_sqrt_two = pos.new_tensor(2.0).rsqrt()
+    polynomial = torch.stack(
+        [
+            torch.ones_like(x),
+            x,
+            y,
+            z,
+            inverse_sqrt_two * x.square(),
+            inverse_sqrt_two * y.square(),
+            inverse_sqrt_two * z.square(),
+            x * y,
+            x * z,
+            y * z,
+        ],
+        dim=-1,
+    )
+    gaussian = torch.exp(
+        -pos.square().sum(dim=-1, keepdim=True) * scales[None, :]
+    )
