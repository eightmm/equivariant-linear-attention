    },
    {
      "id": "C-303",
      "text": "Static spatial attention beats private static EGNN latency and measured working-plus-edge memory at N=8192,k=64 and k=128 on the recorded workload.",
      "status": "supported",
      "evidence": ["gpu-crossover-confirmation.json", "analysis.json", "report.md"]
    },
    {
      "id": "C-304",
      "text": "Coordinate-updating spatial attention beats private static EGNN latency at N=8192,k=64.",
      "status": "unsupported",
      "evidence": ["gpu-crossover-confirmation.json", "analysis.json", "report.md"]
    },
    {
      "id": "C-305",
      "text": "Edge-free spatial attention is universally faster or lower-memory across sparse and dense workloads.",
      "status": "unsupported",
      "evidence": ["gpu-benchmark-optimized.json", "analysis.json", "report.md"]
    },
    {
      "id": "C-306",
      "text": "The synthetic systems crossover establishes domain accuracy or arbitrary topology preservation.",
      "status": "unsupported",
      "evidence": ["scope.md", "report.md", "verification-summary.json"]
    }
  ],
  "limitations": [
    "The candidate and EGNN execute different equations and do not receive matched topology; the candidate receives no adjacency.",
    "The k=64 static advantage is only 2.7% and should be remeasured after any environment or kernel change.",
    "The first measured grid motivated a disclosed post-outcome implementation optimization; the initial output is retained as exploratory.",
    "The k=80 and k=96 confirmation points were selected post hoc to localize dynamic crossover and are exploratory.",
