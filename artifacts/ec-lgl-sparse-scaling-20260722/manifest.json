      ]
    },
    {
      "id": "C-102",
      "text": "The implemented edge-conditioned local sum is permutation-consistent and O(3)-equivariant for its tested scalar, polar-vector and even rank-2 feature boundary.",
      "status": "supported",
      "evidence": [
        "sparse-implementation.json",
        "verification-summary.json",
        "report.md"
      ]
    },
    {
      "id": "C-103",
      "text": "The exact factorized global kernel avoids an N-by-N pair tensor and crosses the materialized dense evaluation of the same kernel on the measured large-N regime.",
      "status": "supported",
      "evidence": [
        "same-kernel-results.json",
        "scaling-analysis.md"
      ]
    },
    {
      "id": "C-104",
      "text": "A bounded-local plus factorized-global EC-LGL has O(E_local + N) content-validated model execution at fixed width and can avoid the dense-edge EGNN regime when E_local is capped.",
      "status": "supported",
      "evidence": [
        "scaling-results.json",
        "scaling-analysis.md",
        "sparse-implementation.json"
      ]
    },
    {
      "id": "C-105",
      "text": "The frozen EC-LGL composite improves the matched bounded QM9 validation screen enough to justify confirmation.",
